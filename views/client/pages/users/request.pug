extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    include ../../partials/list-btn-user.pug

    .row
      .col-12
        +box-head("Lời mời đã gửi")

    .row
      each user in users
        .col-6
          div(class="box-user" data-request-status="pending")
            div(class="inner-avatar")
              img(
                src=(user.avatar ? user.avatar : "https://img.freepik.com/premium-vector/male-face-avatar-icon-set-flat-design-social-media-profiles_1281173-3806.jpg?w=2000")
                alt=user.fullName
              )
            div(class="inner-info")
              div(class="inner-name") #{user.fullName}
              div(class="inner-buttons")
                button(
                  class="btn btn-sm btn-secondary mr-1 btn-cancel-friend"
                  btn-cancel-friend=user.id
                ) Hủy

block script
  script(src="/js/users.js")
