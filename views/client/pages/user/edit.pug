extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alertError(5000)

  .container.my-4
    .row
      .col-12
        +box-head("Cap nhat thong tin")

    .row
      .col-12.col-md-8
        form(
          action="/user/edit?_method=PATCH"
          method="POST"
          enctype="multipart/form-data"
        )
          div(class="form-group")
            label(for="fullName") Ho ten
            input(
              type="text"
              class="form-control"
              id="fullName"
              name="fullName"
              value=user.fullName
              required
            )

          div(class="form-group")
            label(for="email") Email
            input(
              type="email"
              class="form-control"
              id="email"
              name="email"
              value=user.email
              required
            )

          div(class="form-group")
            label(for="phone") So dien thoai
            input(
              type="text"
              class="form-control"
              id="phone"
              name="phone"
              value=user.phone
            )

          div(class="form-group")
            label(for="avatar") Avatar
            input(
              type="file"
              class="form-control-file"
              id="avatar"
              name="avatar"
              accept="image/*"
            )
            if user.avatar
              img(src=user.avatar alt=user.fullName width="120px" class="mt-2 rounded")

          button(type="submit" class="btn btn-primary") Cap nhat
          a(href="/user/info" class="btn btn-secondary ml-2") Quay lai
