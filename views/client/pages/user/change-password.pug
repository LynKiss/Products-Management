extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alertError(5000)

  .container.my-4
    .row
      .col-12
        +box-head("Doi mat khau")

    .row
      .col-12.col-md-8
        form(
          action="/user/change-password?_method=PATCH"
          method="POST"
        )
          div(class="form-group")
            label(for="oldPassword") Mat khau cu
            input(
              type="password"
              class="form-control"
              id="oldPassword"
              name="oldPassword"
              required
            )

          div(class="form-group")
            label(for="newPassword") Mat khau moi
            input(
              type="password"
              class="form-control"
              id="newPassword"
              name="newPassword"
              required
            )

          div(class="form-group")
            label(for="confirmPassword") Nhap lai mat khau moi
            input(
              type="password"
              class="form-control"
              id="confirmPassword"
              name="confirmPassword"
              required
            )

          button(type="submit" class="btn btn-primary") Doi mat khau
          a(href="/user/info" class="btn btn-secondary ml-2") Quay lai
