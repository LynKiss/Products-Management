extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head("Chat")

    .row
      .col-12
        .chat

          .inner-body

            .inner-incoming
              .inner-name Em Yêu
              .inner-content
                | A ơi sáng nghe e nha, nhà e không có ai ở nhà cả

            .inner-outgoing
              .inner-content
                | Thế à? Ok e iu

            .inner-incoming
              .inner-name Em Yêu
              .inner-content
                | Nhanh nha nhanh nha

            .inner-outgoing
              .inner-content
                | Ok đến nơi mà thấy ai ở nhà đâu e? khóa cửa mà :(

            .inner-incoming
              .inner-name Em Yêu
              .inner-content
                | Thì em bảo nhà e không ai ở nhà mà :)

          .inner-foot
            form.inner-form(action="" method="POST")
              input(
                type="text"
                name="content"
                placeholder="Nhập nội dung..."
              )
              button
                i.fa-solid.fa-paper-plane