extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head("Chat")

    .row
      .col-12
        .chat

          .inner-body
            each chat in chats  
              div(class=(chat.user_id == user.id ? "inner-outgoing" :"inner-incoming"))
                if(chat.user_id != user.id)
                  .inner-name #{chat.infoUser.fullName}
                .inner-content
                  | #{chat.content}

            //- .inner-outgoing
            //-   .inner-content
            //-     | Thế à? Ok e iu

            //- .inner-incoming
            //-   .inner-name Em Yêu
            //-   .inner-content
            //-     | Nhanh nha nhanh nha

            //- .inner-outgoing
            //-   .inner-content
            //-     | Ok đến nơi mà thấy ai ở nhà đâu e? khóa cửa mà :(

            //- .inner-incoming
            //-   .inner-name Em Yêu
            //-   .inner-content
            //-     | Thì em bảo nhà e không ai ở nhà mà :)

          .inner-foot
            form.inner-form(action="" method="POST")
              input(
                type="text"
                name="content"
                placeholder="Nhập nội dung..."
              )
              button
                i.fa-solid.fa-paper-plane